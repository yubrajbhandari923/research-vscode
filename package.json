{
  "name": "research-vscode",
  "private": true,
  "version": "0.7.0",
  "description": "Research Panel — VS Code extension + Python core/CLI for research provenance and memory.",
  "scripts": {
    "postinstall": "npm --prefix packages/vscode-extension install --no-audit --no-fund",
    "build": "npm --prefix packages/vscode-extension run build",
    "typecheck": "npm --prefix packages/vscode-extension run typecheck",
    "package": "bash scripts/package.sh",
    "test": "python3 -m pytest -q && npm run typecheck && npm run test:client",
    "test:ext": "npm --prefix packages/vscode-extension run test:ext",
    "demo": "bash examples/alpha-sweep/run_demo.sh",
    "test:client": "npm --prefix packages/vscode-extension run test:client"
  }
}
