#!/usr/bin/env python3
"""Stand-in provider binary for the investigator (tests/python/test_investigator.py): prints a claude-style JSON result with a scripted reply and cost.
FAKE_INVESTIGATOR_REPLY  file whose text is the model's reply (default: an empty object)
FAKE_INVESTIGATOR_COST   total_cost_usd reported (default 0.25)
FAKE_INVESTIGATOR_LOG    file that receives the prompt (last argv) so tests can see what the agent was given
Nothing here talks to a model."""
import json
import os
import sys

reply = open(os.environ["FAKE_INVESTIGATOR_REPLY"]).read() if os.environ.get("FAKE_INVESTIGATOR_REPLY") else "{}"
if os.environ.get("FAKE_INVESTIGATOR_LOG"):
    open(os.environ["FAKE_INVESTIGATOR_LOG"], "a").write(sys.argv[-1] + "\n=====\n")
print(json.dumps({"type": "result", "result": reply, "total_cost_usd": float(os.environ.get("FAKE_INVESTIGATOR_COST", "0.25")),
                  "usage": {"input_tokens": 10, "output_tokens": 5}, "num_turns": 1, "session_id": "fake"}))
