#!/usr/bin/env python3
"""Stand-in for the opencode binary, behaviour from env (see docs/PHASE_CLEANUP_2_DESIGN.md D.11). Event shapes were captured from a
real opencode 1.19.5 run (free model): top-level `type` step_start|tool_use|text|step_finish, `sessionID` on every line, tokens/cost
inside `part` of step_finish. Nothing here talks to a model.

FAKE_OPENCODE_VERSION  "opencode v2.1.4" | "1.19.4" (default "1.19.4")
FAKE_OPENCODE_SCENARIO ok | hang_after_stop | no_final | error | tool_calls_then_stop | slow_silent
FAKE_OPENCODE_LOG      file that receives {"argv", "config", "env"} as JSON
FAKE_OPENCODE_NO_RESUME  `run --help` omits --session
"""
import json
import os
import sys
import time

args = sys.argv[1:]
scenario = os.environ.get("FAKE_OPENCODE_SCENARIO", "ok")
if "--version" in args or "-v" in args:
    print(os.environ.get("FAKE_OPENCODE_VERSION", "1.19.4"))
    sys.exit(0)
if args[:1] == ["models"]:
    print("opencode/big-pickle\nanthropic/claude-sonnet-5-5")
    sys.exit(0)
if args[:2] == ["run", "--help"]:
    print("opencode run [message..]\n  -m, --model\n  -f, --file\n  --format\n  --variant" + ("" if os.environ.get("FAKE_OPENCODE_NO_RESUME") else "\n  -s, --session"))
    sys.exit(0)
if "--help" in args:
    print("opencode [project]\n  --prompt  prompt to use\n  --model")
    sys.exit(0)
if args[:2] == ["mcp", "list"]:
    print("research")
    sys.exit(0)
if args[:1] != ["run"]:
    sys.exit(0)

if os.environ.get("FAKE_OPENCODE_LOG"):
    with open(os.environ["FAKE_OPENCODE_LOG"], "w") as f:
        json.dump({"argv": args, "config": json.loads(os.environ.get("OPENCODE_CONFIG_CONTENT") or "null"),
                   "env": {k: os.environ.get(k) for k in ("RESEARCH_AGENT", "RESEARCH_AGENT_ROLE", "RESEARCH_ROOT", "PWD")}}, f)

sid = args[args.index("--session") + 1] if "--session" in args else "ses_test1"


def emit(type_, **part):
    print(json.dumps({"type": type_, "timestamp": 1794111915523, "sessionID": sid, "part": part}), flush=True)


def finish(reason, i, o, cost):
    emit("step_finish", reason=reason, type="step-finish", tokens={"total": i + o, "input": i, "output": o, "reasoning": 0, "cache": {"write": 0, "read": 5}}, cost=cost)


emit("step_start", type="step-start")
if scenario == "error":
    print(json.dumps({"type": "error", "timestamp": 1794111915999, "sessionID": sid, "error": {"name": "UnknownError", "data": {"message": "Rate limit exceeded"}}}), flush=True)
    sys.exit(1)
if scenario == "slow_silent":
    time.sleep(600)
if scenario in ("ok", "hang_after_stop", "tool_calls_then_stop", "no_final"):
    if scenario in ("tool_calls_then_stop", "no_final"):
        emit("tool_use", type="tool", tool="bash", state={"status": "completed"})
        finish("tool-calls", 100, 10, 0.001)
        emit("step_start", type="step-start")
    if scenario == "no_final":
        sys.exit(0)
    emit("text", type="text", text="done")
    finish("stop", 200, 20, 0.002)
if scenario == "hang_after_stop":
    time.sleep(600)
