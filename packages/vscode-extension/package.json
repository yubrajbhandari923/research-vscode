          "command": "research.plan.create",
          "when": "view == research.plans",
          "group": "navigation"
        },
        {
          "command": "research.question.create",
          "when": "view == research.questions",
          "group": "navigation"
        },
        {
          "command": "research.experiment.create",
          "when": "view == research.experiments",
          "group": "navigation"
        },
