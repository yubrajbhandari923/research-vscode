{
  "name": "research-panel",
  "displayName": "Research Panel",
  "description": "Research memory for computational projects: questions → experiments → runs → findings → decisions → checkpoints. Project-local, agent-aware, Remote-SSH friendly.",
  "version": "0.1.0",
  "publisher": "research-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Data Science",
    "Notebooks"
  ],
  "keywords": [
    "research",
    "experiments",
    "provenance",
    "hpc",
    "slurm",
    "agents"
  ],
  "icon": "media/icon.png",
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.research/config.yaml",
    "onStartupFinished"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yubrajbhandari/research-vscode"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "node esbuild.mjs --production && node scripts/bundle-python.mjs && vsce package --no-dependencies --out ../../dist/",
    "test:ext": "node test/run.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@vscode/codicons": "^0.0.36",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.9.3"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "research",
          "title": "Research",
          "icon": "media/research.svg"
        }
      ]
    },
    "views": {
      "research": [
        {
          "type": "webview",
          "id": "research.overview",
          "name": "Overview",
          "icon": "media/research.svg",
          "when": "research.initialized",
          "initialSize": 3
        },
        {
          "id": "research.plans",
          "name": "Plans",
          "icon": "media/research.svg",
          "when": "research.initialized",
          "initialSize": 2
        },
        {
          "id": "research.questions",
          "name": "Questions",
          "icon": "media/research.svg",
          "when": "research.initialized",
          "initialSize": 2
        },
        {
          "id": "research.experiments",
          "name": "Experiments",
          "icon": "media/research.svg",
          "when": "research.initialized",
          "initialSize": 2
        },
        {
          "id": "research.findings",
          "name": "Findings",
          "icon": "media/research.svg",
          "when": "research.initialized",
          "initialSize": 2
        },
        {
          "id": "research.decisions",
          "name": "Decisions",
          "icon": "media/research.svg",
          "visibility": "collapsed",
          "when": "research.initialized"
        },
        {
          "id": "research.checkpoints",
          "name": "Checkpoints",
          "icon": "media/research.svg",
          "visibility": "collapsed",
          "when": "research.initialized"
        },
        {
          "id": "research.notes",
          "name": "Notes",
          "icon": "media/research.svg",
          "visibility": "collapsed",
          "when": "research.initialized"
        },
        {
          "id": "research.artifacts",
          "name": "Artifacts",
          "icon": "media/research.svg",
          "visibility": "collapsed",
          "when": "research.initialized"
        },
        {
          "id": "research.agent",
          "name": "Agent Context",
          "icon": "media/research.svg",
          "visibility": "collapsed",
          "when": "research.initialized"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "research.overview",
        "contents": "No research project in this workspace yet.\n[Initialize Project](command:research.init)\nCreates `.research/` and an `AGENTS.md` block. Nothing else in your repo is touched.",
        "when": "!research.initialized && research.ready"
      },
      {
        "view": "research.overview",
        "contents": "Starting research core…",
        "when": "!research.ready"
      }
    ],
    "commands": [
      {
        "command": "research.init",
        "title": "Initialize Project",
        "category": "Research",
        "icon": "$(add)"
      },
      {
