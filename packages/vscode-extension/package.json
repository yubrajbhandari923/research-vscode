        {
          "command": "research.resume",
          "when": "view == research.overview",
          "group": "navigation@1"
        },
        {
          "command": "research.checkpoint.create",
          "when": "view == research.overview",
          "group": "navigation@2"
        },
        {
          "command": "research.refresh",
          "when": "view == research.overview",
          "group": "navigation@3"
        },
