        {
          "command": "research.artifact.register",
          "when": "research.initialized",
          "group": "7_research@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "research.artifact.register",
          "when": "research.initialized && resourceScheme == file",
          "group": "7_research"
        }
      ]
    },
    "configuration": {
      "title": "Research Panel",
      "properties": {
        "research.pythonPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Python ≥ 3.8 used to run the bundled research core **on the machine where the workspace lives** (the remote host under Remote SSH). Empty = auto-detect `python3`."
        },
        "research.terminalCommand": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Put a `research` command on `PATH` in VS Code terminals (so you and coding agents can use the CLI without installing it)."
        },
        "research.pollIntervalSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 3,
          "description": "How often to refresh status while runs are active."
        },
        "research.defaultRunMode": {
          "type": "string",
          "enum": [
            "terminal",
            "background",
            "slurm"
          ],
          "default": "terminal",
          "enumDescriptions": [
            "Run in an integrated terminal (live output)",
            "Detached background process",
            "Submit to SLURM"
          ],
          "description": "Default execution mode for 'Run…'."
        },
        "research.projectRoot": {
          "type": "string",
          "default": "",
          "description": "Override the project root (defaults to the first workspace folder containing .research/, else the first folder)."
        }
      }
    },
    "keybindings": [
      {
        "command": "research.resume",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "research.initialized"
      }
    ]
