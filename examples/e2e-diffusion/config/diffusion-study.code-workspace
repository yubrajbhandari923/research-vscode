{
  "folders": [
    {
      "name": "main (code)",
      "path": "main"
    },
    {
      "name": "ledger (research records)",
      "path": "ledger"
    },
    {
      "name": "EXP-001 (experiment code)",
      "path": "experiments/EXP-001"
    }
